<UserControl x:Class="GSTJsonToExcel.Features.AnnualReport.Views.AnnualReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="960">

    <UserControl.Resources>
        <!-- Modern Elevated Card Style -->
        <Style x:Key="AnnualCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Step Badge Circle -->
        <Style x:Key="StepNumberBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Month Coverage Pill Template -->
        <Style x:Key="MonthPillBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="#DCFCE7" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Error Banner if any -->
        <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                Visibility="{Binding HasErrorBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorBannerText}" Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!-- STEP 1: Input Selection -->
        <Border Style="{StaticResource AnnualCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column with Wrap & Margin so it NEVER overlaps with right buttons -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StepNumberBadgeStyle}">
                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select GST Return Files (JSON / ZIP)" 
                                       FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="SINGLE MONTH OR FULL YEAR" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="Select or drag &amp; drop any GSTR-3B, GSTR-1, GSTR-2A, and GSTR-2B files. Uploaded months are automatically populated and missing months are left blank." 
                                   FontSize="12" Foreground="#64748B" Margin="36,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Right Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📄 Add Files..." Command="{Binding AddFilesCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="15,8" Margin="0,0,8,0" />
                        <Button Content="📁 Add Folder..." Command="{Binding AddFolderCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="15,8" Margin="0,0,8,0" />
                        <Button Content="🗑 Clear" Command="{Binding ClearFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="13,8" />
                    </StackPanel>
                </Grid>

                <!-- Status Drop Banner -->
                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#DBEAFE" CornerRadius="6" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding ScanBadgeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- STEP 2: Auto-Detected Preview & Month Coverage Matrix -->
        <Border Style="{StaticResource AnnualCardStyle}"
                Visibility="{Binding HasScannedFiles, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StepNumberBadgeStyle}">
                                <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Auto-Detected Return &amp; Month Coverage Matrix" 
                                       FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="Green (✓) = Return file uploaded for month  •  Gray (—) = Not uploaded (will remain empty in Excel)" 
                                   FontSize="12" Foreground="#64748B" Margin="36,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Financial Year:" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding AvailableFinancialYears}"
                                  SelectedItem="{Binding SelectedFinancialYear, Mode=TwoWay}"
                                  Width="185" Height="32" VerticalContentAlignment="Center" FontWeight="SemiBold" Padding="8,0" />
                    </StackPanel>
                </Grid>

                <!-- Interactive Month-Wise Selection Panel -->
                <Border Background="#F8FAFC" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                        Visibility="{Binding HasAvailableMonths, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="📅 Select Months to Include (Month-Wise):" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedMonthsSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                </Border>
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✓ Select All Months" Command="{Binding SelectAllMonthsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11.5" Margin="0,0,6,0" />
                                <Button Content="✕ Unselect All" Command="{Binding DeselectAllMonthsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11.5" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AvailableMonths}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsSelected, Converter={StaticResource BoolToBrush}, ConverterParameter='#EFF6FF|#FFFFFF'}"
                                            BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrush}, ConverterParameter='#2563EB|#CBD5E1'}"
                                            BorderThickness="1.5"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            Margin="0,0,8,6"
                                            Cursor="Hand">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"
                                                  Foreground="{Binding IsSelected, Converter={StaticResource BoolToBrush}, ConverterParameter='#1E40AF|#475569'}"
                                                  VerticalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding MonthLabel}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding FileCount, StringFormat=' ({0})'}" FontSize="11" Opacity="0.85" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding CoverageRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#F8FAFC"
                          BorderBrush="#CBD5E1"
                          BorderThickness="1"
                          RowHeight="30"
                          ColumnHeaderHeight="32"
                          MaxHeight="250">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Company GSTIN" Binding="{Binding Gstin}" Width="145" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="State" Binding="{Binding StateName}" Width="105" />
                        <DataGridTextColumn Header="Return" Binding="{Binding ReturnTypeLabel}" Width="80" FontWeight="Bold" />
                        <DataGridTextColumn Header="Filed" Binding="{Binding SummaryBadge}" Width="55" FontWeight="Bold" />

                        <DataGridTemplateColumn Header="Apr" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Apr}">
                                        <TextBlock Text="{Binding Apr, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="May" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding May}">
                                        <TextBlock Text="{Binding May, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Jun" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Jun}">
                                        <TextBlock Text="{Binding Jun, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Jul" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Jul}">
                                        <TextBlock Text="{Binding Jul, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Aug" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Aug}">
                                        <TextBlock Text="{Binding Aug, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Sep" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Sep}">
                                        <TextBlock Text="{Binding Sep, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Oct" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Oct}">
                                        <TextBlock Text="{Binding Oct, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Nov" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Nov}">
                                        <TextBlock Text="{Binding Nov, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Dec" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Dec}">
                                        <TextBlock Text="{Binding Dec, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Jan" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Jan}">
                                        <TextBlock Text="{Binding Jan, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Feb" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Feb}">
                                        <TextBlock Text="{Binding Feb, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Mar" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MonthPillBorderStyle}" Tag="{Binding Mar}">
                                        <TextBlock Text="{Binding Mar, Converter={StaticResource BoolToText}, ConverterParameter='✓|—'}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- STEP 3: Report Configuration -->
        <Border Style="{StaticResource AnnualCardStyle}"
                Visibility="{Binding HasScannedFiles, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                    <Border Style="{StaticResource StepNumberBadgeStyle}">
                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Report Configuration &amp; Sheet Selection" 
                               FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                </WrapPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Box: Company Name & Output Folder -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Company Name (shown on Overview Card):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5" />
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12" />

                            <TextBlock Text="Output Folder:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding OutputFolderPath, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="6,0,0,0" />
                            </Grid>

                            <CheckBox IsChecked="{Binding SeparateWorkbookPerGstin}"
                                      Content="Also generate a separate workbook per GSTIN"
                                      FontWeight="SemiBold" Foreground="#1E293B" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Right Box: Company GSTIN Column Display Mode -->
                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Column A (Company GSTIN) Display Format:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
                            <RadioButton GroupName="GstinDisplayGroup" IsChecked="{Binding IsShowGstinAndState}" Content="Show GSTIN + State name (e.g. 07XXXXX... (Delhi))" Margin="0,0,0,7" />
                            <RadioButton GroupName="GstinDisplayGroup" IsChecked="{Binding IsShowStateOnly}" Content="Show State name only (e.g. Delhi, Haryana)" Margin="0,0,0,7" />
                            <RadioButton GroupName="GstinDisplayGroup" IsChecked="{Binding IsShowCustomBranchName}" Content="Show custom branch name per GSTIN" Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding CustomLabelItems}"
                                          Visibility="{Binding IsShowCustomBranchName, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Gstin}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding CustomLabel, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="6,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Sheets to Include -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Sheets to Include in Workbook (Exact Order):" 
                                   FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8" />
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IncludeOverview}" Content="Overview" FontWeight="SemiBold" Margin="0,0,20,6" />
                            <CheckBox IsChecked="{Binding IncludeGstr3B}" IsEnabled="{Binding CanInclude3B}" Content="GSTR-3B" FontWeight="SemiBold" Margin="0,0,20,6" />
                            <CheckBox IsChecked="{Binding IncludeGstr1}" IsEnabled="{Binding CanInclude1}" Content="GSTR-1" FontWeight="SemiBold" Margin="0,0,20,6" />
                            <CheckBox IsChecked="{Binding IncludeGstr2A}" IsEnabled="{Binding CanInclude2A}" Content="GSTR-2A" FontWeight="SemiBold" Margin="0,0,20,6" />
                            <CheckBox IsChecked="{Binding IncludeGstr2B}" IsEnabled="{Binding CanInclude2B}" Content="GSTR-2B" FontWeight="SemiBold" Margin="0,0,20,6" />
                            <CheckBox IsChecked="{Binding Include3BVs1}" IsEnabled="{Binding CanInclude3BVs1}" Content="GSTR-3B vs GSTR-1" FontWeight="SemiBold" Margin="0,0,20,6" />
                            <CheckBox IsChecked="{Binding Include3BVs2A}" IsEnabled="{Binding CanInclude3BVs2A}" Content="GSTR-3B vs GSTR-2A" FontWeight="SemiBold" Margin="0,0,20,6" />
                            <CheckBox IsChecked="{Binding Include3BVs2B}" IsEnabled="{Binding CanInclude3BVs2B}" Content="GSTR-3B vs GSTR-2B" FontWeight="SemiBold" Margin="0,0,20,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- STEP 4: Generate Button & Post-Generation Summary -->
        <Border Style="{StaticResource AnnualCardStyle}"
                Visibility="{Binding HasScannedFiles, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource StepNumberBadgeStyle}">
                                <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Generate GST Summary &amp; Reconciliation Workbook" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ProgressStatusText}" FontSize="12" Foreground="#475569" Margin="36,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⚡ Generate Summary &amp; Reconciliation (.xlsx)"
                                Command="{Binding GenerateAnnualReportCommand}"
                                Style="{StaticResource SuccessButtonStyle}"
                                FontSize="13.5" FontWeight="Bold" Padding="22,11" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,10" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Post-Generation Summary -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding HasGenerationResult, Converter={StaticResource BoolToVis}}">
                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="✅ Workbook Generated Successfully" FontSize="14" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding IncludedSheetsSummary, StringFormat='Included Sheets: {0}'}" FontSize="12" Foreground="#15803D" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SkippedSheetsSummary, StringFormat='Skipped Info: {0}'}" FontSize="11.5" Foreground="#475569" Margin="0,0,0,12" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding GeneratedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="📊 Open Excel"
                                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Padding="12,6" Margin="0,0,6,0" />
                                                    <Button Content="📂 Show in Folder"
                                                            Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="12,6" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Reconciliation Variance Alerts -->
                    <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="8" Padding="16"
                            Visibility="{Binding HasReconciliationAlerts, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="⚠️ Reconciliation Variances Detected (Non-Zero Differences)" FontSize="13.5" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding ReconciliationAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding GstinDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding ComparisonSheet}" FontWeight="Bold" FontSize="12" Foreground="#92400E" />
                                            <TextBlock Grid.Column="2" Text="{Binding MetricName}" FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding FormattedDifference}" FontWeight="Bold" FontSize="12" Foreground="#DC2626" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
