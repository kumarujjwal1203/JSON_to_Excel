<Window x:Class="GSTJsonToExcel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GSTJsonToExcel.Models"
        mc:Ignorable="d"
        Title="GST JSON to Excel Converter — Professional Octa Edition"
        Icon="app_icon.ico"
        Height="720" Width="1020"
        MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="#F8FAFC"
        FontFamily="{StaticResource MainFont}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Filter Chip Button Style -->
        <Style x:Key="FilterChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Bar with Gradient -->
        <Border Grid.Row="0" Padding="24,14" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="Arrow">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0.0" />
                    <GradientStop Color="#1E3A8A" Offset="0.6" />
                    <GradientStop Color="#2563EB" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="24" Width="44" Height="44" Margin="0,0,12,0" Background="White" ClipToBounds="True" Padding="1" VerticalAlignment="Center">
                        <Image Source="app_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GST JSON TO EXCEL CONVERTER" 
                                   FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Separate Excel per JSON file • Octa GST Layout • 100% Zero Data Loss Guarantee" 
                                   FontSize="11.5" Foreground="#CBD5E1" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="🔒 100% Offline" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                    </Border>
                    <Border Background="#166534" CornerRadius="12" Padding="10,4" Margin="0,0,14,0">
                        <TextBlock Text="v2.5 Professional" FontSize="11" FontWeight="SemiBold" Foreground="#86EFAC" />
                    </Border>

                    <!-- Custom Window Minimize, Maximize, Close Buttons -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="3" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="—" Click="MinimizeButton_Click" ToolTip="Minimize Application" Style="{StaticResource WindowControlButtonStyle}" Margin="0,0,2,0" />
                            <Button x:Name="MaximizeButton" Content="🗖" Click="MaximizeButton_Click" ToolTip="Maximize / Restore Window" Style="{StaticResource WindowControlButtonStyle}" Margin="0,0,2,0" />
                            <Button Content="✕" Click="CloseButton_Click" ToolTip="Close Application" Style="{StaticResource WindowCloseButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,20">

                <!-- 1. Selection & Drop Zone Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="1. Select Input GST Files or Directory" 
                                           FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Select multiple JSON files or an entire folder. Drag &amp; drop supported anytime." 
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="📄 Select Files..." 
                                        Command="{Binding SelectFilesCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,8" Margin="0,0,8,0" />
                                <Button Content="📁 Select Folder..." 
                                        Command="{Binding SelectFolderCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,8" />
                            </StackPanel>
                        </Grid>

                        <!-- Drop Zone Visual Box -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="📂" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectionTitle}" 
                                               FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" 
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectionSubtitle}" 
                                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="6" Padding="10,6" VerticalAlignment="Center"
                                        Visibility="{Binding HasScannedFiles, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ReadyToProcessCount, StringFormat='Ready: {0} files'}" 
                                               FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Conversion Mode Selector Card -->
                <Border Style="{StaticResource ModernCardStyle}"
                        Visibility="{Binding HasScannedFiles, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="2. Choose Output Mode" 
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Option A: Individual File per JSON (User's Exact Need) -->
                            <Border Grid.Column="0" 
                                    Background="{Binding IsIndividualMode, Converter={StaticResource BoolToBrush}, ConverterParameter='#EFF6FF|#FFFFFF'}" 
                                    BorderBrush="{Binding IsIndividualMode, Converter={StaticResource BoolToBrush}, ConverterParameter='#2563EB|#CBD5E1'}" 
                                    BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <RadioButton GroupName="ConversionModeGroup" 
                                             IsChecked="{Binding IsIndividualMode}"
                                             VerticalContentAlignment="Top">
                                    <StackPanel Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄 Individual Excel per JSON File" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="Bold" Foreground="#15803D" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Each JSON file produces its own separate Excel file (e.g. R2B_001.json → R2B_001.xlsx) formatted in the exact Octa GST layout." 
                                                   FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Option B: Merged by Type -->
                            <Border Grid.Column="1" 
                                    Background="{Binding IsMergedMode, Converter={StaticResource BoolToBrush}, ConverterParameter='#EFF6FF|#FFFFFF'}" 
                                    BorderBrush="{Binding IsMergedMode, Converter={StaticResource BoolToBrush}, ConverterParameter='#2563EB|#CBD5E1'}" 
                                    BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                                <RadioButton GroupName="ConversionModeGroup" 
                                             IsChecked="{Binding IsMergedMode}"
                                             VerticalContentAlignment="Top">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="📚 Consolidate by GST Return Type" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                        <TextBlock Text="Combines all JSON files of the same return type into a single workbook (e.g. all R2B files merged into R2B.xlsx)." 
                                                   FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Interactive File List & Classification Dashboard -->
                <Border Style="{StaticResource ModernCardStyle}"
                        Visibility="{Binding HasScannedFiles, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Summary Badges Grid -->
                        <UniformGrid Columns="6" Margin="0,0,0,16">
                            <!-- R1 Badge -->
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="R1 Files" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding R1Count}" FontSize="18" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="GSTR-1" FontSize="9" Foreground="#4ADE80" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- R2A Badge -->
                            <Border Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="6" Padding="8" Margin="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="R2A Files" FontSize="11" FontWeight="SemiBold" Foreground="#7E22CE" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding R2ACount}" FontSize="18" FontWeight="Bold" Foreground="#6B21A8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="GSTR-2A" FontSize="9" Foreground="#C084FC" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- R2B Badge -->
                            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="8" Margin="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="R2B Files" FontSize="11" FontWeight="SemiBold" Foreground="#C2410C" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding R2BCount}" FontSize="18" FontWeight="Bold" Foreground="#9A3412" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="GSTR-2B" FontSize="9" Foreground="#FB923C" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- R3A Badge -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8" Margin="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="R3A Files" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding R3ACount}" FontSize="18" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="GSTR-3B" FontSize="9" Foreground="#60A5FA" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Duplicates Badge -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="8" Margin="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Duplicates" FontSize="11" FontWeight="SemiBold" Foreground="#B91C1C" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DuplicateCount}" FontSize="18" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="Skipped" FontSize="9" Foreground="#F87171" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Ignored Badge -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Ignored" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding IgnoredCount}" FontSize="18" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="Non-JSON" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Filter Chips & Search Bar -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>

                            <!-- Filter Chips & Selection Controls -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="All Files" Command="{Binding SetFilterCategoryCommand}" CommandParameter="All" Style="{StaticResource FilterChipStyle}" />
                                <Button Content="R1" Command="{Binding SetFilterCategoryCommand}" CommandParameter="R1" Style="{StaticResource FilterChipStyle}" />
                                <Button Content="R2A" Command="{Binding SetFilterCategoryCommand}" CommandParameter="R2A" Style="{StaticResource FilterChipStyle}" />
                                <Button Content="R2B" Command="{Binding SetFilterCategoryCommand}" CommandParameter="R2B" Style="{StaticResource FilterChipStyle}" />
                                <Button Content="R3A" Command="{Binding SetFilterCategoryCommand}" CommandParameter="R3A" Style="{StaticResource FilterChipStyle}" />

                                <!-- Select/Deselect Links -->
                                <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource FilterChipStyle}" Background="#E0F2FE" BorderBrush="#BAE6FD" />
                                <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" Style="{StaticResource FilterChipStyle}" Background="#F1F5F9" />
                            </StackPanel>

                            <!-- Search Box -->
                            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             FontSize="12" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Interactive DataGrid for Scanned Files -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" MaxHeight="260">
                            <DataGrid ItemsSource="{Binding FilteredCandidateItems}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      RowHeight="36"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <!-- Select Checkbox -->
                                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />

                                    <!-- Return Type Badge -->
                                    <DataGridTemplateColumn Header="Type" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileType}" FontWeight="Bold" FontSize="10" Foreground="White" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Source File Name -->
                                    <DataGridTextColumn Header="Source JSON File" Binding="{Binding FileName}" Width="*" FontWeight="SemiBold" />

                                    <!-- Target Excel Output Name -->
                                    <DataGridTextColumn Header="Target Excel Output" Binding="{Binding TargetExcelFileName}" Width="160" Foreground="#0284C7" />

                                    <!-- File Size -->
                                    <DataGridTextColumn Header="Size" Binding="{Binding FileSizeFormatted}" Width="80" Foreground="#64748B" />

                                    <!-- Live Status Badge -->
                                    <DataGridTemplateColumn Header="Status" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessingStateDisplay}" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Convert Button -->
                        <Button Content="🚀 Convert Selected Files to Excel" 
                                Command="{Binding ConvertCommand}"
                                Style="{StaticResource SuccessButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="48" Margin="0,16,0,12" />

                        <!-- Progress Section -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProgressPhase}" FontWeight="SemiBold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="1" Text="{Binding OverallProgressPercentage, StringFormat='Overall: {0}%'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryBrush}" />
                        </Grid>

                        <ProgressBar Height="10" Minimum="0" Maximum="100" 
                                     Value="{Binding OverallProgressPercentage}" 
                                     Foreground="{StaticResource PrimaryBrush}" 
                                     Background="#E2E8F0" BorderThickness="0" />

                        <TextBlock Text="{Binding CurrentFileDisplay}" 
                                   FontWeight="SemiBold" FontSize="11" Foreground="#475569" 
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding ProgressMessage}" 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 4. Conversion Results Card (Visible upon completion) -->
                <Border Style="{StaticResource ModernCardStyle}"
                        BorderBrush="#107C41" BorderThickness="1.5"
                        Visibility="{Binding ConversionSuccessful, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Conversion Completed Successfully" 
                                               FontSize="16" FontWeight="Bold" Foreground="#107C41" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding CompletionSummaryDisplay}" 
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,3,0,0" />
                            </StackPanel>

                            <!-- Open Output Folder Button -->
                            <Button Grid.Column="1" Content="📂 Open Output Folder" 
                                    Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Padding="18,8" FontSize="12" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Generated Excel Workbooks:" 
                                   FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,10" />

                        <!-- Generated Files Interactive List -->
                        <ItemsControl ItemsSource="{Binding GeneratedFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Type Tag -->
                                            <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="4" Padding="8,3" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FileType}" FontWeight="Bold" FontSize="11" Foreground="White" />
                                            </Border>

                                            <!-- File Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" />
                                                <TextBlock Text="{Binding SourceFileName, StringFormat='Source: {0} • 100% Zero Data Loss Verified'}" 
                                                           FontSize="11" Foreground="#64748B" />
                                            </StackPanel>

                                            <!-- Record Count -->
                                            <TextBlock Grid.Column="2" Text="{Binding TotalRecordsExported, StringFormat='{}{0:N0} Records'}" 
                                                       FontWeight="Bold" FontSize="12" Foreground="#107C41" VerticalAlignment="Center" Margin="0,0,16,0" />

                                            <!-- Open File Button -->
                                            <Button Grid.Column="3" Content="📊 Open Excel" 
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding OutputFilePath}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="12,5" FontSize="11" Margin="0,0,6,0" />

                                            <!-- Show in Folder Button -->
                                            <Button Grid.Column="4" Content="📁 Show in Folder" 
                                                    Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding OutputFilePath}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="12,5" FontSize="11" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 5. Error Card (Visible on Error) -->
                <Border Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="⚠️ Attention / Error" FontSize="14" FontWeight="Bold" Foreground="#991B1B" />
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#B91C1C" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔒 100% Offline &amp; Private" FontWeight="SemiBold" FontSize="11" Foreground="#475569" />
                    <TextBlock Text=" — All JSON files are converted locally on your computer. Original files are never modified." FontSize="11" Foreground="#94A3B8" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 Reset / Select New Files" 
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,5" FontSize="11" Margin="0,0,8,0" />
                    <Button Content="✕ Exit Application" 
                            Click="CloseButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5"
                            Padding="12,5" FontSize="11" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
